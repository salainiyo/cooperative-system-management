# Databases (never commit real user data / password hashes)
coop_db/
*.db
*.sqlite3

# Environment
.env
.env.*
!.env.example

# Node
node_modules/
dist/

# Python
__pycache__/
.venv/
.pytest_cache/
*.pyc

# Terraform (state, provider dir and real tfvars stay local — secrets!)
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example
infra/terraform/crash.log

# Ansible (generated inventory + vault-encrypted secrets)
infra/ansible/inventory/hosts.yml
infra/ansible/inventory/group_vars/all/vault.yml
infra/ansible/*vault-password*
