# Managed by Ansible — secrets from group_vars/vault.yml (ansible-vault).
# Compose's `environment:` section overrides DATABASE_URL for the backend
# container, so it is intentionally absent here.
SECRET_KEY={{ SECRET_KEY }}
ALGORITHM=HS256
EXPIRATION_TIME_MINUTES=30
EXPIRATION_TIME_DAYS=3
POSTGRES_PASSWORD={{ POSTGRES_PASSWORD }}
ALLOWED_ORIGINS=https://{{ domain }}
FRONTEND_URL=https://{{ domain }}
REDIS_URL=redis://redis:6379/0
