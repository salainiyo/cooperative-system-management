# Managed by Ansible — minimal observability stack for the 1 GB instance.
# Prometheus + alerting only (no Grafana): hard memory caps keep the micro
# instance's budget intact; UI is exposed via Caddy with basic auth.
services:
  prometheus:
    image: prom/prometheus:v3.15.0
    container_name: prometheus
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ prometheus_retention }}
      - --web.route-prefix=/prometheus
      - --web.external-url=https://{{ domain }}/prometheus/
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./alerts.yml:/etc/prometheus/alerts.yml:ro
      - prometheus_data:/prometheus
    environment:
      GOMEMLIMIT: 170MiB
    mem_limit: 192m
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:9090/prometheus/-/healthy"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 30s
    restart: unless-stopped

  alertmanager:
    image: prom/alertmanager:v0.34.1
    container_name: alertmanager
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --web.route-prefix=/alertmanager
      - --web.external-url=https://{{ domain }}/alertmanager/
    volumes:
      - ./alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
    mem_limit: 48m
    restart: unless-stopped

  node_exporter:
    image: prom/node-exporter:v1.12.1
    container_name: node_exporter
    pid: host
    command:
      - --path.rootfs=/host
      - --collector.filesystem.mount-points-exclude=^/(dev|proc|sys|run|var/lib/docker/.+)($$|/)
    volumes:
      - /:/host:ro,rslave
    mem_limit: 32m
    restart: unless-stopped

  blackbox_exporter:
    image: prom/blackbox-exporter:v0.29.0
    container_name: blackbox_exporter
    command:
      - --config.file=/etc/blackbox/blackbox.yml
    volumes:
      - ./blackbox.yml:/etc/blackbox/blackbox.yml:ro
    mem_limit: 32m
    restart: unless-stopped

volumes:
  prometheus_data:
