global:
  smtp_smarthost: "smtp.gmail.com:587"
  smtp_from: "{{ OBS_SMTP_USER }}"
  smtp_auth_username: "{{ OBS_SMTP_USER }}"
  smtp_auth_password: "{{ OBS_SMTP_PASSWORD }}"
  smtp_require_tls: true

route:
  receiver: email
  group_by:
    - alertname
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h

receivers:
  - name: email
    email_configs:
      - to: "{{ OBS_ALERTS_TO }}"
        send_resolved: true
