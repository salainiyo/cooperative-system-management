# Copy this file to `.env` (root of the repository) and fill in real values.
# docker-compose.yml loads it via `env_file: .env`.

# --- Security (REQUIRED) ---
# Long, random string. Changing it invalidates every existing session.
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
EXPIRATION_TIME_MINUTES=30
EXPIRATION_TIME_DAYS=3

# --- Database & cache ---
# docker-compose.yml overrides DATABASE_URL with the postgres service below;
# these values are what you use for local development / bare-metal runs.
# DATABASE_URL=sqlite:///./dev.db            # zero-setup local dev
# DATABASE_URL=postgresql+psycopg2://coop:change-me@localhost:5432/coop
DATABASE_URL=sqlite:///./dev.db
# Password for the PostgreSQL container (also set the same var in .env)
POSTGRES_PASSWORD=change-me-strong-password
REDIS_URL=redis://redis:6379/0

# --- CORS & frontend ---
# Comma-separated list of browser origins allowed to call the API.
# In production this must be your real domain (e.g. https://ikimina.duckdns.org).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Used to build password-reset links inside emails.
FRONTEND_URL=http://localhost:5173

# --- Optional (frontend build) ---
# Only needed if the API is on a different origin than the frontend.
# When omitted the frontend calls the same origin under /api (Caddy strips it).
# VITE_API_URL=https://api.example.com
